# Optional for demo; required for account synchronization. Never use service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local Ollama only. Select an installed model inside the app.
OLLAMA_URL=http://127.0.0.1:11434
PORT=8787
HOST=127.0.0.1
# Required when HOST=0.0.0.0 to use the app from your phone (minimum 16 characters).
KOOMIDA_LOCAL_KEY=

# Comma-separated exclusions configured locally, never personal health data in Git.
# Keep both values equal and rebuild after changes.
HOUSEHOLD_EXCLUDED_ALLERGENS=
VITE_HOUSEHOLD_EXCLUDED_ALLERGENS=
